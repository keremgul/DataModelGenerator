<UserControl x:Class="DataModelGenerator.App.Views.GenerationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:DataModelGenerator.App.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,16,24,8">
            <TextBlock Text="Adım 3 — Model Üretimi" Style="{StaticResource StepHeader}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Modeli Üret" Command="{Binding GenerateCommand}"
                        Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                <Button Content="İptal" Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="{Binding RoundInfo}" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="#666" FontSize="12"/>
            </StackPanel>
            <!-- Adım göstergesindeki "3. Üretim" adımının altında çalışan
                 pipeline adımları; ayrıntısı docs/pipeline.md içinde. -->
            <TextBlock Text="{Binding PipelineStages}" FontSize="11" Foreground="#8894A8"
                       TextWrapping="Wrap" Margin="0,8,0,0"
                       ToolTip="Pipeline adımları. Akış diyagramları için: docs/pipeline.md"/>
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource InfoText}" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="24,0,24,0">

            <TabItem Header="ER Diyagramı">
                <ctrl:MermaidViewer MermaidCode="{Binding MermaidCode}"/>
            </TabItem>

            <!-- Özet: serbest metin yerine izlenebilirlik tablosu. Soldaki kaynak
                 listesi ters yön gezinmeyi sağlar (BR/cevap → türeyen alanlar). -->
            <TabItem Header="Özet">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="8,8,4,8">
                        <TextBlock DockPanel.Dock="Top" Text="Kaynaklar" Style="{StaticResource SectionHeader}"
                                   Margin="0,0,0,2"/>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource InfoText}" Margin="0,0,0,4"
                                   Text="Bir kurala veya cevaba tıklayın: o kaynaktan türeyen alanlar sağda listelenir."/>
                        <Button DockPanel.Dock="Bottom" Content="Tümünü Göster" Margin="0,6,0,0"
                                Command="{Binding ClearTraceFilterCommand}"/>

                        <ListBox ItemsSource="{Binding TraceSources}"
                                 SelectedItem="{Binding SelectedTraceSource}"
                                 AutomationProperties.Name="KaynakListesi">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2" ToolTip="{Binding Tooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding RuleId}" FontSize="10" FontWeight="Bold"
                                                       Foreground="White" Background="#2F5496" Padding="5,1"/>
                                            <TextBlock Text="{Binding UsageText}" FontSize="10" Foreground="#888"
                                                       Margin="6,1,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ShortText}" FontSize="11" Foreground="#444"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <Grid Grid.Column="1" Margin="4,8,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding TraceFilterText}" Style="{StaticResource InfoText}"
                                   Margin="0,0,0,4"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding TraceEntries}"
                                  SelectedItem="{Binding SelectedTraceEntry}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  AutomationProperties.Name="IzlenebilirlikTablosu">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="ToolTip" Value="{Binding Tooltip}"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Varlık" Binding="{Binding Entity}" Width="130"/>
                                <DataGridTextColumn Header="Alan" Binding="{Binding Attribute}" Width="150"/>
                                <DataGridTextColumn Header="Anahtar" Binding="{Binding KeyText}" Width="110"/>
                                <!-- Uzun açıklama yok: kısa rozet + tooltip. -->
                                <DataGridTextColumn Header="Kaynak" Binding="{Binding Badges}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#2F5496"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="BR metni" Binding="{Binding RuleSummary}" Width="*"/>
                                <DataGridTextColumn Header="Kaynak soru" Binding="{Binding QuestionSummary}" Width="160"/>
                                <DataGridTextColumn Header="Verilen cevap" Binding="{Binding AnswerSummary}" Width="150"/>
                                <DataGridTextColumn Header="NF durumu" Binding="{Binding NormalizationStatus}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Satıra tıklandığında kaynaklar tam metniyle açılır. -->
                        <Border Grid.Row="2" Background="#F8FAFF" BorderBrush="#C5D5F0" BorderThickness="1"
                                CornerRadius="3" Padding="10,8" Margin="0,6,0,0" MaxHeight="190"
                                Visibility="{Binding SelectedTraceEntry, Converter={StaticResource NullToCollapsed}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel DataContext="{Binding SelectedTraceEntry}">
                                    <TextBlock FontWeight="SemiBold" Foreground="#1F3864" Margin="0,0,0,4">
                                        <Run Text="{Binding Entity, Mode=OneWay}"/><Run Text="."/><Run Text="{Binding Attribute, Mode=OneWay}"/>
                                    </TextBlock>

                                    <ItemsControl ItemsSource="{Binding Sources}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding RuleId}" FontSize="10" FontWeight="Bold"
                                                               Foreground="White" Background="#2F5496" Padding="5,1"
                                                               HorizontalAlignment="Left"/>
                                                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True"
                                                             BorderThickness="0" Background="Transparent"
                                                             TextWrapping="Wrap" FontSize="12" Padding="0" Margin="0,2,0,0"/>
                                                    <StackPanel Visibility="{Binding IsQuestion, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBox Text="{Binding QuestionText, Mode=OneWay}" IsReadOnly="True"
                                                                 BorderThickness="0" Background="Transparent" FontSize="12"
                                                                 FontStyle="Italic" Foreground="#555" TextWrapping="Wrap" Padding="0"/>
                                                        <TextBox Text="{Binding Answer, Mode=OneWay}" IsReadOnly="True"
                                                                 BorderThickness="0" Background="Transparent" FontSize="12"
                                                                 Foreground="#2C4218" TextWrapping="Wrap" Padding="0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding NormalizationExplanation}" TextWrapping="Wrap"
                                               FontSize="11" Foreground="#666"
                                               Visibility="{Binding NormalizationExplanation, Converter={StaticResource NullToCollapsed}}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Modele alınmayan öğeler: kaynaksız, belirsiz veya normalizasyonu geçemeyen. -->
            <TabItem Header="Beklemede">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding PendingCountText}"
                               Style="{StaticResource InfoText}" Margin="12,10,12,6"/>

                    <DataGrid ItemsSource="{Binding PendingItems}" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              AutomationProperties.Name="BeklemedeListesi">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                            <DataGridTextColumn Header="Tür" Binding="{Binding KindText}" Width="110"/>
                            <DataGridTextColumn Header="Hedef" Binding="{Binding Target}" Width="190"/>
                            <DataGridTextColumn Header="Neden" Binding="{Binding ReasonText}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#8C1D18"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Şüphe kaynağı" Binding="{Binding SourceText}" Width="120"/>
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding Explanation}" Width="*"/>
                            <DataGridTextColumn Header="Sorulan soru" Binding="{Binding Question}" Width="240"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Öneriler">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="#F5F5F5" BorderBrush="#DDD"
                            BorderThickness="0,1,0,0" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Önerileri Uygula" Command="{Binding ApplySuggestionsCommand}"
                                    Style="{StaticResource PrimaryButton}" IsEnabled="{Binding HasSuggestions}"
                                    ToolTip="Yalnızca 'Kabul' olarak işaretlenen öneriler modele uygulanır."/>
                            <Button Content="Yeni Öneriler Üret" Command="{Binding RequestSuggestionsCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                    ToolTip="Soru cevaplarını ve güncel modeli dikkate alarak yeni öneriler üretir."/>
                            <TextBlock Text="Reddedilen öneriler modele yansıtılmaz ve tekrar önerilmez."
                                       Style="{StaticResource InfoText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <ItemsControl ItemsSource="{Binding Suggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F3F7FF" BorderBrush="#C5D5F0" BorderThickness="1"
                                            CornerRadius="3" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding StatusText}" Foreground="#375623"
                                                       FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"
                                                       Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                        Visibility="{Binding IsApplied, Converter={StaticResource InverseBoolToVisibility}}">
                                                <CheckBox Content="Kabul" IsChecked="{Binding IsAccepted}" Margin="0,0,16,0"/>
                                                <CheckBox Content="Reddet" IsChecked="{Binding IsRejected}"/>
                                            </StackPanel>
                                            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,6,0,0" TextWrapping="Wrap" AcceptsReturn="True"
                                                     MinHeight="26"
                                                     Visibility="{Binding IsApplied, Converter={StaticResource InverseBoolToVisibility}}"
                                                     ToolTip="Açıklama/koşul ekleyebilirsiniz; kabul edilen öneriyle birlikte modele iletilir."/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="Belirsizlikler">
                <DataGrid ItemsSource="{Binding Ambiguities}" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Etki" Binding="{Binding Impact}" Width="60"/>
                        <DataGridTextColumn Header="Tür" Binding="{Binding Kind}" Width="120"/>
                        <DataGridTextColumn Header="Hedef" Binding="{Binding Target}" Width="180"/>
                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Uygulanan Varsayılan" Binding="{Binding AppliedDefault}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Doğrulama + normalizasyon notları: ikisi de modelin sağlık raporu. -->
            <TabItem Header="Doğrulama">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding ValidationIssues}" AutoGenerateColumns="False"
                              IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Seviye" Binding="{Binding Severity}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="200"/>
                            <DataGridTextColumn Header="Hedef" Binding="{Binding Target}" Width="200"/>
                            <DataGridTextColumn Header="Mesaj" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1" Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="0,1,0,0"
                            Padding="12,8" MaxHeight="180"
                            Visibility="{Binding NormalizationNotes, Converter={StaticResource CountToVisibility}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Normalizasyon Notları" FontWeight="SemiBold"
                                           Foreground="#444" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding NormalizationNotes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"
                                                       FontSize="12" Foreground="#555"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="← Geri" Command="{Binding BackCommand}"/>
                <Button Content="Sorulara Geç →" Command="{Binding NextCommand}"
                        Style="{StaticResource PrimaryButton}" IsEnabled="{Binding HasModel}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
