<UserControl x:Class="DataModelGenerator.App.Views.QuestionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,16,24,8">
            <TextBlock Text="Adım 4 — Belirsizlikler ve Yönlendirici Sorular" Style="{StaticResource StepHeader}" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource InfoText}"/>
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,0">
            <StackPanel>

                <ItemsControl ItemsSource="{Binding Questions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#C5D5F0" BorderThickness="1" CornerRadius="4"
                                    Background="#F8FAFF" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Id}" FontWeight="Bold" Foreground="#2F5496" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Kind}" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Target}" Foreground="#888" FontSize="11"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,6,0,4"/>
                                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Foreground="#666"
                                               FontStyle="Italic" FontSize="12" Margin="0,0,0,6"/>

                                    <ItemsControl ItemsSource="{Binding Options}"
                                                  Visibility="{Binding Options, Converter={StaticResource CountToVisibility}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#E8EFFB" CornerRadius="10" Padding="8,3" Margin="0,0,6,6">
                                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="#1F3864"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBox Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="46"
                                             VerticalScrollBarVisibility="Auto"
                                             ToolTip="Cevabınız kural listesine yeni bir madde olarak eklenir."/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Otomatik Çözülen Düşük Etkili Belirsizlikler" Style="{StaticResource SectionHeader}"
                           Visibility="{Binding AutoResolved, Converter={StaticResource CountToVisibility}}"/>
                <ItemsControl ItemsSource="{Binding AutoResolved}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1"
                                    CornerRadius="3" Padding="10,6" Margin="0,0,0,5">
                                <StackPanel>
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Target}"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Foreground="#555"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="← Geri" Command="{Binding BackCommand}"/>
                <Button Content="Cevapları Uygula (kısmi güncelleme)" Command="{Binding ApplyAnswersCommand}"
                        Style="{StaticResource PrimaryButton}" IsEnabled="{Binding HasQuestions}"/>
                <Button Content="Reprompt'a Geç →" Command="{Binding NextCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
