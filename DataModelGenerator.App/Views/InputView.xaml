<UserControl x:Class="DataModelGenerator.App.Views.InputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,16,24,0">
            <TextBlock Text="Adım 2 — Business Rule Listesi" Style="{StaticResource StepHeader}" Margin="0,0,0,6"/>
            <TextBlock Style="{StaticResource InfoText}"
                       Text="Kuralları tek tek ya da toplu yapıştırarak ekleyin. Kurallar yalnızca satır satır değil, aralarındaki anlam ilişkisiyle birlikte değerlendirilir; çelişen veya tekrar eden kurallar size soru olarak döner."/>

            <!-- Mevcut yapı: oradaki tablolar yeniden üretilmez, referans alınır. -->
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Mevcut Yapı Yükle (.md)" Command="{Binding LoadExistingStructureCommand}"
                        ToolTip="Konuyla ilgili mevcut tabloları anlatan dosya. Oradaki tablolar yeniden oluşturulmaz; yeni yapılar bunlarla ilişkilendirilir."/>
                <Button Content="Kaldır" Command="{Binding ClearExistingStructureCommand}" MinWidth="70"/>
                <TextBlock Text="{Binding ExistingStructureSummary}" Style="{StaticResource InfoText}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Kural girişi -->
        <Grid Grid.Row="1" Margin="24,12,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text="{Binding NewRuleText, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="64" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     ToolTip="Tek bir kural yazın ya da birden çok satırı yapıştırın."/>
            <Button Grid.Column="1" Content="Ekle" Command="{Binding AddRulesCommand}"
                    Style="{StaticResource PrimaryButton}" MinWidth="90" Margin="8,2,0,2"
                    VerticalAlignment="Stretch"/>
        </Grid>

        <!-- Kural listesi -->
        <DataGrid Grid.Row="2" Margin="24,12,24,0"
                  ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="No" Binding="{Binding Id}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Business Rule" Binding="{Binding Text}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Padding" Value="0,4"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="AcceptsReturn" Value="True"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Kaynak" Binding="{Binding Origin}" Width="110" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Margin="24,8,24,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Yukarı Taşı" Command="{Binding MoveUpCommand}"/>
                <Button Content="Aşağı Taşı" Command="{Binding MoveDownCommand}"/>
                <Button Content="Seçili Kuralı Sil" Command="{Binding RemoveRuleCommand}"/>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource InfoText}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,6,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>

            <!-- Artımlı güncellemede önceki ve yeni model arasındaki fark. -->
            <Border Background="#E8F5E9" BorderBrush="#A7C796" BorderThickness="1" CornerRadius="3"
                    Padding="10,8" Margin="0,8,0,0" MaxHeight="120"
                    Visibility="{Binding ChangeSummary, Converter={StaticResource NullToCollapsed}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding ChangeSummary}" FontWeight="SemiBold"
                                   Foreground="#1B5E20" FontSize="12" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding Changes}" Margin="0,2,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="#2C4218"
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <Border Grid.Row="4" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,1,0,0"
                Padding="16,10" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="← Geri" Command="{Binding BackCommand}"/>
                <Button Content="Modeli Üret →" Command="{Binding NextCommand}" Style="{StaticResource PrimaryButton}"/>
                <Button Content="Kuralları Ekle ve Modeli Güncelle"
                        Command="{Binding ExtendCommand}"
                        Visibility="{Binding HasModel, Converter={StaticResource BoolToVisibility}}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        ToolTip="Mevcut model sıfırdan üretilmez; yalnızca yeni kuralların gerektirdiği değişiklikler yapılır."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
