<Application x:Class="DataModelGenerator.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DataModelGenerator.App.ViewModels"
             xmlns:views="clr-namespace:DataModelGenerator.App.Views"
             xmlns:conv="clr-namespace:DataModelGenerator.App.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:NullOrEmptyToCollapsedConverter x:Key="NullToCollapsed"/>
        <conv:CountToVisibilityConverter x:Key="CountToVisibility"/>
        <conv:ConfidenceToBrushConverter x:Key="ConfidenceToBrush"/>
        <conv:SeverityToBrushConverter x:Key="SeverityToBrush"/>

        <!-- ViewModel → View eşlemesi -->
        <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
            <views:ConnectionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InputViewModel}">
            <views:InputView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GenerationViewModel}">
            <views:GenerationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuestionsViewModel}">
            <views:QuestionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RepromptViewModel}">
            <views:RepromptView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExportViewModel}">
            <views:ExportView/>
        </DataTemplate>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="StepHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Foreground" Value="#1F3864"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="Foreground" Value="#2F5496"/>
        </Style>
        <Style x:Key="InfoText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2F5496"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CodeBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>

    </Application.Resources>
</Application>
