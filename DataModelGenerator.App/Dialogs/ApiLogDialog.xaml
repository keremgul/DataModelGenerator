<Window x:Class="DataModelGenerator.App.Dialogs.ApiLogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="API İstek / Yanıt Detayı" Height="620" Width="780"
        MinHeight="400" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="⚠ " FontSize="16" Foreground="#C00000" VerticalAlignment="Center"/>
            <TextBlock x:Name="TitleBlock" FontWeight="Bold" FontSize="14"
                       Foreground="#C00000" VerticalAlignment="Center"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Hata">
                <TextBox x:Name="ErrorBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                         Background="#FFF5F5" Padding="8"/>
            </TabItem>

            <TabItem Header="İstek">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="UrlBlock" Grid.Row="0" FontFamily="Consolas" FontSize="11"
                               FontWeight="SemiBold" Foreground="#003366" Margin="8,8,8,4" TextWrapping="Wrap"/>
                    <TextBox x:Name="RequestBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" Background="#F5F9FF" Padding="8"/>
                </Grid>
            </TabItem>

            <TabItem Header="Yanıt">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="StatusBlock" Grid.Row="0" FontFamily="Consolas" FontSize="12"
                               FontWeight="Bold" Margin="8,8,8,4"/>
                    <TextBox x:Name="ResponseBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" Background="#F5F9FF" Padding="8"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LogPathBlock" Grid.Column="0" FontSize="10" Foreground="#888"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CopyAllBtn" Content="Tümünü Kopyala" Width="130" Margin="0,0,8,0" Click="CopyAll_Click"/>
                <Button Content="Tamam" IsDefault="True" Width="90" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
