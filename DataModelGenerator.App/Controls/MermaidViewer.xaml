<UserControl x:Class="DataModelGenerator.App.Controls.MermaidViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">

    <Grid>
        <wv2:WebView2 x:Name="Browser"/>

        <Border x:Name="FallbackPanel" Background="#FFF8E1" BorderBrush="#E0C97F"
                BorderThickness="1" Padding="16" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Diyagram görüntüleyici başlatılamadı"
                           FontWeight="Bold" Foreground="#8A6D00" Margin="0,0,0,6"/>
                <TextBlock x:Name="FallbackMessage" TextWrapping="Wrap" Foreground="#5F4B00"/>
                <TextBlock Text="Mermaid kodunu 'Mermaid Kodu' sekmesinden kopyalayabilir veya dosya olarak indirebilirsiniz."
                           TextWrapping="Wrap" Foreground="#5F4B00" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
